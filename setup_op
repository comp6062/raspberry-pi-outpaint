import io, os, json
from datetime import datetime
from fastapi import FastAPI, UploadFile, File, Form, Request
from fastapi.responses import HTMLResponse, StreamingResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from fastapi.middleware.cors import CORSMiddleware
from PIL import Image, ImageDraw
import numpy as np
import cv2
import piexif

APP_DIR = os.path.expanduser("~/op_app")
MODEL_DIR = os.path.join(APP_DIR, "models")
LOG_DIR = os.path.join(APP_DIR, "logs")
TMP_DIR = os.path.join(APP_DIR, "tmp")

HOST, PORT = "127.0.0.1", 8080
MAX_UPLOAD_MB, MAX_SIDE = 20, 1536

FACE_PROTO_URL = "https://raw.githubusercontent.com/opencv/opencv/master/samples/dnn/face_detector/deploy.prototxt"
FACE_MODEL_URL = "https://github.com/opencv/opencv_3rdparty/raw/dnn_samples_face_detector_20170830/res10_300x300_ssd_iter_140000.caffemodel"
FACE_PROTO_PATH = os.path.join(MODEL_DIR, "deploy.prototxt")
FACE_MODEL_PATH = os.path.join(MODEL_DIR, "res10_300x300_ssd_iter_140000.caffemodel")

app = FastAPI(title="RPi5 Outpainting (Local)")
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://127.0.0.1", "http://localhost"],
    allow_credentials=False,
    allow_methods=["*"],
    allow_headers=["*"],
)
app.mount("/static", StaticFiles(directory=os.path.join(APP_DIR, "app/static")), name="static")

def log(msg: str):
  ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
  with open(os.path.join(LOG_DIR, "server.log"), "a", encoding="utf-8") as f:
    f.write(f"[{ts}] {msg}\n")

def ensure_models():
  os.makedirs(MODEL_DIR, exist_ok=True)
  if not os.path.exists(FACE_PROTO_PATH):
    os.system(f"curl -L --fail -o {FACE_PROTO_PATH} {FACE_PROTO_URL}")
  if not os.path.exists(FACE_MODEL_PATH):
    os.system(f"curl -L --fail -o {FACE_MODEL_PATH} {FACE_MODEL_URL}")

def read_image_keep_exif(data: bytes):
  exif = None
  try:
    exif = piexif.load(io.BytesIO(data))
  except Exception:
    exif = None
  img = Image.open(io.BytesIO(data)).convert("RGB")
  return img, exif

def clamp_size(img: Image.Image) -> Image.Image:
  w, h = img.size
  scale = min(1.0, float(MAX_SIDE) / max(w, h))
  if scale < 1.0:
    img = img.resize((int(w*scale), int(h*scale)), Image.LANCZOS)
  return img

def expand_canvas_and_mask(img: Image.Image, top: int, right: int, bottom: int, left: int):
  w, h = img.size
  W, H = w + left + right, h + top + bottom
  canvas = Image.new("RGB", (W, H), (0, 0, 0))
  canvas.paste(img, (left, top))
  mask = Image.new("L", (W, H), 0)
  d = ImageDraw.Draw(mask)
  if top    > 0: d.rectangle((0, 0, W-1, top-1), fill=255)
  if bottom > 0: d.rectangle((0, H-bottom, W-1, H-1), fill=255)
  if left   > 0: d.rectangle((0, 0, left-1, H-1), fill=255)
  if right  > 0: d.rectangle((W-right, 0, W-1, H-1), fill=255)
  return canvas, mask

def to_cv(img: Image.Image): return cv2.cvtColor(np.array(img), cv2.COLOR_RGB2BGR)
def from_cv(arr: np.ndarray): return Image.fromarray(cv2.cvtColor(arr, cv2.COLOR_BGR2RGB))

def inpaint_borders(canvas: Image.Image, mask_img: Image.Image, passes: int = 3) -> Image.Image:
  src = to_cv(canvas)
  mask = np.array(mask_img)
  if mask.ndim == 3:
    mask = cv2.cvtColor(mask, cv2.COLOR_BGR2GRAY)
  mask = (mask > 0).astype(np.uint8) * 255
  kernel = np.ones((5,5), np.uint8)
  mask = cv2.dilate(mask, kernel, iterations=1)

  out = src.copy()
  for i in range(passes):
    method = cv2.INPAINT_TELEA if (i % 2 == 0) else cv2.INPAINT_NS
    out = cv2.inpaint(out, mask, 3, method)
    out = cv2.GaussianBlur(out, (0,0), 0.8)
    out = cv2.addWeighted(out, 1.35, cv2.GaussianBlur(out,(0,0),1.15), -0.35, 0)
  return from_cv(out)

def photoreal_refine(img: Image.Image) -> Image.Image:
  cv = to_cv(img)
  smooth = cv2.bilateralFilter(cv, d=9, sigmaColor=75, sigmaSpace=75)
  lab = cv2.cvtColor(smooth, cv2.COLOR_BGR2LAB)
  l, a, b = cv2.split(lab)
  clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))
  l2 = clahe.apply(l)
  out = cv2.cvtColor(cv2.merge([l2,a,b]), cv2.COLOR_LAB2BGR)
  return from_cv(out)

def face_preserve(img: Image.Image) -> Image.Image:
  ensure_models()
  if not (os.path.exists(FACE_PROTO_PATH) and os.path.exists(FACE_MODEL_PATH)):
    return img
  try:
    net = cv2.dnn.readNetFromCaffe(FACE_PROTO_PATH, FACE_MODEL_PATH)
  except Exception:
    return img
  cv = to_cv(img)
  h, w = cv.shape[:2]
  blob = cv2.dnn.blobFromImage(cv2.resize(cv,(300,300)), 1.0, (300,300), (104.0,177.0,123.0))
  net.setInput(blob)
  det = net.forward()
  for i in range(det.shape[2]):
    conf = float(det[0,0,i,2])
    if conf < 0.6: continue
    x1,y1,x2,y2 = (det[0,0,i,3:7]*np.array([w,h,w,h])).astype(int)
    x1,y1 = max(0,x1-10), max(0,y1-10)
    x2,y2 = min(w-1,x2+10), min(h-1,y2+10)
    face = cv[y1:y2, x1:x2]
    if face.size == 0: continue
    up = cv2.resize(face, (0,0), fx=1.5, fy=1.5, interpolation=cv2.INTER_CUBIC)
    den = cv2.fastNlMeansDenoisingColored(up, None, 5, 5, 7, 21)
    sharp = cv2.addWeighted(den, 1.3, cv2.GaussianBlur(den,(0,0),1.0), -0.3, 0)
    back = cv2.resize(sharp, (x2-x1, y2-y1), interpolation=cv2.INTER_LANCZOS4)
    cv[y1:y2, x1:x2] = back
  return from_cv(cv)

@app.get("/", response_class=HTMLResponse)
async def index(request: Request):
  with open(os.path.join(APP_DIR, "app/templates/index.html"), "r", encoding="utf-8") as f:
    return HTMLResponse(f.read())

@app.post("/api/outpaint")
async def api_outpaint(
  file: UploadFile = File(...),
  expand_top: int = Form(0),
  expand_right: int = Form(0),
  expand_bottom: int = Form(0),
  expand_left: int = Form(0),
  refine: int = Form(0),
  face_fix: int = Form(0)
):
  try:
    raw = await file.read()
    if len(raw) > MAX_UPLOAD_MB * 1024 * 1024:
      return JSONResponse({"error": f"File too large (>{MAX_UPLOAD_MB}MB)"}, status_code=400)
    img, _ = read_image_keep_exif(raw)
    img = clamp_size(img)
    canvas, mask = expand_canvas_and_mask(img, expand_top, expand_right, expand_bottom, expand_left)
    out = inpaint_borders(canvas, mask)
    if refine: out = photoreal_refine(out)
    if face_fix: out = face_preserve(out)
    buf = io.BytesIO()
    out.save(buf, format="PNG"); buf.seek(0)
    meta = {"original_size": img.size, "expanded":[expand_top,expand_right,expand_bottom,expand_left], "refine":bool(refine), "face_preserve":bool(face_fix)}
    return StreamingResponse(buf, media_type="image/png", headers={"X-Meta": json.dumps(meta)})
  except Exception as e:
    log(f"/api/outpaint error: {e}")
    return JSONResponse({"error": str(e)}, status_code=500)

@app.get("/api/health")
async def health():
  return {"ok": True, "time": datetime.now().isoformat()}

if __name__ == "__main__":
