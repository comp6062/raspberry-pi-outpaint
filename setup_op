red(){ printf "\033[31m%s\033[0m\n" "$*"; }
green(){ printf "\033[32m%s\033[0m\n" "$*"; }
yellow(){ printf "\033[33m%s\033[0m\n" "$*"; }
need_cmd(){ command -v "$1" >/dev/null 2>&1 || { red "Missing command: $1"; exit 1; }; }

check_python(){
  need_cmd python3
  local pv
  pv="$(python3 - <<'PYMIN'
import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")
PYMIN
)"
  awk -v v1="$pv" -v v2="$PYTHON_MIN" 'BEGIN{split(v1,a,".");split(v2,b,".");exit (a[1]>b[1] || (a[1]==b[1] && a[2]>=b[2]))?0:1}' \
    || { red "Python >= ${PYTHON_MIN} required (found ${pv})"; exit 1; }
}

check_port_free(){
  if ss -ltn | awk '{print $4}' | grep -q "^${HOST}:${PORT}\$"; then
    red "Port ${PORT} on ${HOST} is already in use."
    exit 1
  fi
}

