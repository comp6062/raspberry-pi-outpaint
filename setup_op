#!/usr/bin/env bash
# RPi5 Outpainting — Launcher (localhost only)
set -euo pipefail
APP_DIR="$HOME/op_app"
VENV_DIR="$APP_DIR/.venv"
LOG_DIR="$APP_DIR/logs"
HOST="127.0.0.1"
PORT="8080"
die(){ printf "\033[31m[ERR]\033[0m %s\n" "$*" >&2; exit 1; }
[ -d "$APP_DIR" ] || die "Missing $APP_DIR (run setup)"
[ -d "$VENV_DIR" ] || die "Missing venv (run setup)"
[ -f "$APP_DIR/app/main.py" ] || die "Missing backend main.py"
[ -f "$APP_DIR/app/__init__.py" ] || install -Dm644 /dev/stdin "$APP_DIR/app/__init__.py" <<<"# package marker"
mkdir -p "$LOG_DIR"
if ss -ltn | awk '{print $4}' | grep -q "^${HOST}:${PORT}\$"; then die "Port ${PORT} in use"; fi
# shellcheck disable=SC1091
source "$VENV_DIR/bin/activate"
cd "$APP_DIR"
export PYTHONUNBUFFERED=1
uvicorn app.main:app --host "$HOST" --port "$PORT" --no-access-log --log-level info 2>&1 | tee -a "$LOG_DIR/uvicorn.log"
RUN_OP

